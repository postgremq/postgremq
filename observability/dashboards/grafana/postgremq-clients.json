            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "true"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "redelivered"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "false"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "first delivery"
              }
            ]
