          "expr": "sum by (postgremq_redelivered) (rate(messaging_client_consumed_messages_total{messaging_system=\"postgremq\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
