        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Queues",
      "description": "From postgremq.queue_metrics(), scraped by the Collector. Every queue receives each message published to the topic. Select a queue to open it.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (topic_name, queue_name) (postgremq_queue_active_ratio{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic_name, queue_name) (postgremq_queue_messages_ready{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic_name, queue_name) (postgremq_queue_messages_processing{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic_name, queue_name) (postgremq_queue_messages_delayed{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "D",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic_name, queue_name) (postgremq_queue_messages_exhausted{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "E",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic_name, queue_name) (postgremq_queue_messages_dead_letter{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "F",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (topic_name, queue_name) (postgremq_queue_oldest_ready_age_seconds{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "G",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "topic_name": true
            },
            "renameByName": {
              "Value #A": "Active",
              "Value #B": "Ready",
              "Value #C": "Processing",
              "Value #D": "Delayed",
              "Value #E": "Exhausted",
              "Value #F": "Dead letter",
              "Value #G": "Oldest ready age"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "queue_name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open queue ${__data.fields.queue_name}",
                    "url": "/d/postgremq-queue/postgremq-queue?${datasource:queryparam}&${database:queryparam}&${topic:queryparam}&var-queue=${__data.fields.queue_name}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest ready age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": true
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
