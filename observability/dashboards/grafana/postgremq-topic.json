    {
      "type": "stat",
      "title": "Worst oldest ready age",
      "description": "From postgremq.queue_metrics(), scraped by the Collector. The longest any delivery on the topic's queues waits for a consumer.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(postgremq_queue_oldest_ready_age_seconds{service_instance_id=~\"$database\", topic_name=\"$topic\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
