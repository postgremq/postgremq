        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Failed publish attempts by error type",
      "description": "Needs instrumented clients: applications that pass a meter provider to the PostgreMQ client (docs/observability.md). Empty when none do. Client metrics carry no database identity: this panel is not filtered by Database, and same-named queues or topics in different databases are added together. Publishes to a topic that does not exist appear only on the Clients dashboard.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (error_type) (rate(messaging_client_sent_messages_total{messaging_system=\"postgremq\", messaging_destination_name=\"$topic\", messaging_operation_name=\"publish\", error_type!=\"\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{error_type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
