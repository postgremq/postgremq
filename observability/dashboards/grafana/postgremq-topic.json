    {
      "type": "row",
      "title": "Producers",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Publish attempts by service",
      "description": "Needs instrumented clients: applications that pass a meter provider to the PostgreMQ client (docs/observability.md). Empty when none do. Client metrics carry no database identity: this panel is not filtered by Database, and same-named queues or topics in different databases are added together. Successful publish attempts per second. An attempt in a caller-owned transaction counts when the SQL call returns, even if the transaction later rolls back.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name) (rate(messaging_client_sent_messages_total{messaging_system=\"postgremq\", messaging_destination_name=\"$topic\", messaging_operation_name=\"publish\", error_type=\"\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
